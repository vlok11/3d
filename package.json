{
  "name": "immersa-3d-scene-viewer",
  "version": "1.0.0",
  "description": "AI-powered 2D to 3D scene reconstruction using React Three Fiber and TensorFlow.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "lint:strict": "eslint src --max-warnings 0 && tsc --noEmit",
    "clean": "rimraf dist node_modules/.vite",
    "prepare": "echo 'Ready to develop!'"
  },
  "keywords": [
    "react",
    "three.js",
    "3d",
    "depth-estimation",
    "ai",
    "gemini",
    "tensorflow"
  ],
  "dependencies": {
    "@google/genai": "^1.35.0",
    "@react-three/drei": "^9.117.0",
    "@react-three/fiber": "^8.17.10",
    "@tensorflow-models/depth-estimation": "^0.0.4",
    "@tensorflow/tfjs": "^4.22.0",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.562.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "rimraf": "^6.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^6.0.5",
    "vite-plugin-glsl": "^1.5.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
